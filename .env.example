# Server
PORT=8080
DATA_DIR=/data

# Security — REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-long-random-secret
SESSION_TTL_HOURS=24
NONCE_TTL_MINUTES=10

# Canonical public origin (used for NIP-98 URL binding and the login UI).
# On Railway set to ${{RAILWAY_PUBLIC_DOMAIN}} — it resolves on second deploy.
PUBLIC_URL=

# Paid verification oracle (x402). Set PAID_VERIFY=off to run gate-only mode.
PAID_VERIFY=on
X402_PAY_TO=
X402_PRICE_USD=$0.001
X402_NETWORK=base
X402_FACILITATOR_URL=https://www.x402.org/facilitator

# Forward-auth cookie name (Caddy forward_auth / nginx auth_request).
GATE_COOKIE_NAME=wa_session
